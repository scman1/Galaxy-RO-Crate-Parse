    skos:altLabel "NEXAFS",
        "XANES" .

<http://purl.org/pan-science/PaNET/PaNET2020063> #a owl:Class ;
    rdfs:label "crystallographic study".# ;
    #rdfs:subClassOf <http://purl.org/pan-science/PaNET/PaNET2014000> .

<http://purl.org/pan-science/PaNET/PaNET01196> #a owl:Class ;
