<http://purl.org/pan-science/PaNET/PaNET01082> #a owl:Class ;
    rdfs:label "crystallography-based techniques" ;
    #ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Crystallography" ;
    #rdfs:subClassOf <http://purl.org/pan-science/PaNET/PaNET00400> ;
