<http://purl.org/pan-science/PaNET/PaNET.owl> rdf:type owl:Ontology ;
                                               <http://purl.org/dc/terms/created> "2025-10-21" ;
                                               <http://purl.org/dc/terms/creator> _:genid1 ,
                                                                                  _:genid3 ,
                                                                                  _:genid4 ,
                                                                                  _:genid5 ,
                                                                                  _:genid6 ,
                                                                                  _:genid7 ,
                                                                                  _:genid8 ,
