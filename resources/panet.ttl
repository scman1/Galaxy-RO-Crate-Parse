                                               rdfs:subClassOf <http://purl.org/pan-science/PaNET/PaNET00003> ;
                                               <http://purl.obolibrary.org/obo/IAO_0000115> "Any phenomenon where a particle of the same type as the probe is emitted" ;
                                               rdfs:label "scattering-based techniques" .


###  http://purl.org/pan-science/PaNET/PaNET00201
<http://purl.org/pan-science/PaNET/PaNET00201> rdf:type owl:Class ;
                                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/pan-science/PaNET/PaNET1002000> ;
                                                                     owl:someValuesFrom <http://purl.org/pan-science/PaNET/PaNET2012001>
                                                                   ] ;
                                               rdfs:subClassOf <http://purl.org/pan-science/PaNET/PaNET00003> ;
                                               <http://purl.obolibrary.org/obo/IAO_0000115> "Independent of probe; classed also as scattering if the probe and emitted particles are of the same type; disjoint with elastic scattering" ;
                                               rdfs:label "emission-based techniques" .


###  http://purl.org/pan-science/PaNET/PaNET00202
<http://purl.org/pan-science/PaNET/PaNET00202> rdf:type owl:Class ;
